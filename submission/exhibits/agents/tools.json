    {
      "name": "final_answer",
      "description": "Your critiques. Quote only numbers a tool returned.",
      "parameters": {
        "type": "object",
        "properties": {
          "critiques": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
