{
  "director": [
    {
      "name": "list_candidates",
      "description": "Each candidate's name and what it adds.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "compare",
      "description": "Every candidate over holding months from first_year to the decision: IR, beta, net, cost, turnover, drawdown.",
      "parameters": {
        "type": "object",
        "properties": {
          "first_year": {
            "type": "integer",
            "description": "first holding year"
          }
        },
        "required": [
          "first_year"
        ]
      }
    },
    {
      "name": "by_year",
      "description": "One candidate's net return and IR in each past year.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "final_answer",
      "description": "The candidate to trade next year, and why.",
      "parameters": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "string",
            "enum": [
              "composite",
              "composite+traded",
              "composite+hedged",
              "composite+hedged+traded",
              "scorer25",
              "scorer25+traded",
              "scorer25+hedged",
              "scorer25+hedged+traded",
              "scorer50",
              "scorer50+traded",
              "scorer50+hedged",
              "scorer50+hedged+traded",
              "screened",
              "screened+traded",
              "screened+hedged",
              "screened+hedged+traded",
              "liquid25",
              "liquid25+traded",
              "liquid25+hedged",
              "liquid25+hedged+traded",
              "liquid50",
              "liquid50+traded",
              "liquid50+hedged",
              "liquid50+hedged+traded",
              "veto",
              "veto+traded",
              "veto+hedged",
              "veto+hedged+traded"
            ]
          },
          "reason": {
            "type": "string",
            "description": "why, quoting only numbers a tool returned"
          }
        },
        "required": [
          "candidate",
          "reason"
        ]
      }
    }
  ],
  "discovery": [
    {
      "name": "list_characteristics",
      "description": "The characteristics you may use.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "describe",
      "description": "Coverage and the before-2021 t-statistic of one characteristic on its own.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "backtest",
      "description": "Scores an equal-weight signed formula on 2015-2020, neutralized like the book. You have 30 in total.",
      "parameters": {
        "type": "object",
        "properties": {
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "a characteristic from list_characteristics"
                },
                "sign": {
                  "type": "integer",
                  "enum": [
                    -1,
                    1
                  ],
                  "description": "+1 buy high, -1 buy low"
                }
              },
              "required": [
                "name",
                "sign"
              ]
            },
            "minItems": 1,
            "maxItems": 12
          }
        },
        "required": [
          "terms"
        ]
      }
    },
    {
      "name": "final_answer",
      "description": "Commit to one formula and say why it should keep working after 2020.",
      "parameters": {
        "type": "object",
        "properties": {
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "a characteristic from list_characteristics"
                },
                "sign": {
                  "type": "integer",
                  "enum": [
                    -1,
                    1
                  ],
                  "description": "+1 buy high, -1 buy low"
                }
              },
              "required": [
                "name",
                "sign"
              ]
            },
            "minItems": 1,
            "maxItems": 12
          },
          "hypothesis": {
            "type": "string"
          }
        },
        "required": [
          "terms",
          "hypothesis"
        ]
      }
    }
  ],
  "critic": [
