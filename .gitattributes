# Same line endings on every machine.
* text=auto eol=lf

# Except Windows scripts, which need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git breaks notebooks when merging them.
*.ipynb merge=binary

# The deck source carries its images inline, so it counts as no language.
tools/deck/deck.html linguist-generated
